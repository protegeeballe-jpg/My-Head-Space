---
const { title = "My Head Space" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --bg-midnight: #0b1329;
        --bg-card: rgba(18, 28, 56, 0.85);
        --border-gold: rgba(234, 179, 8, 0.25);
        --text-gold-accent: #eab308;
        --text-cream: #f8fafc;
        --text-muted: #94a3b8;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-midnight);
        background-image: 
          radial-gradient(circle at 15% 20%, rgba(30, 58, 138, 0.5) 0%, transparent 45%),
          radial-gradient(circle at 85% 75%, rgba(161, 98, 7, 0.15) 0%, transparent 50%),
          radial-gradient(circle at 50% 50%, rgba(15, 23, 42, 0.8) 0%, transparent 100%);
        background-attachment: fixed;
        color: var(--text-cream);
        min-height: 100vh;
        margin: 0;
        padding: 50px 20px;
        display: flex;
        justify-content: center;
      }

      .container {
        max-width: 760px;
        width: 100%;
        background: var(--bg-card);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-gold);
        border-radius: 20px;
        padding: 48px;
        box-shadow: 0 8px 32px 0 rgba(11, 19, 41, 0.37);
      }

      .back-link {
        display: inline-block;
        color: var(--text-gold-accent);
        text-decoration: none;
        margin-bottom: 24px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: opacity 0.2s;
      }

      .back-link:hover {
        opacity: 0.8;
      }

      /* Style Markdown headings and text */
      h1, h2, h3 {
        font-family: 'Cormorant Garamond', serif;
        color: #fef08a;
      }

      h1 {
        font-size: 2.8rem;
        margin-top: 0;
        border-bottom: 1px solid var(--border-gold);
        padding-bottom: 16px;
        margin-bottom: 24px;
      }

      p {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #e2e8f0;
        margin-bottom: 20px;
      }

      hr {
        border: none;
        border-top: 1px solid var(--border-gold);
        margin: 30px 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/" class="back-link">← Back to Garden Home</a>
      <slot />
    </div>
  </body>
</html>
