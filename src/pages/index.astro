---
// Homepage for My Head Space - Painterly Dark Blue & Gold Botanical Theme
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Head Space</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --bg-midnight: #0b1329;
        --bg-card: rgba(18, 28, 56, 0.75);
        --border-gold: rgba(234, 179, 8, 0.25);
        --border-gold-hover: rgba(250, 204, 21, 0.6);
        --text-gold-light: #fef08a;
        --text-gold-accent: #eab308;
        --text-cream: #f8fafc;
        --text-muted: #94a3b8;
        --glow: 0 8px 32px 0 rgba(11, 19, 41, 0.37);
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-midnight);
        /* Painterly watercolor radial gradient mesh */
        background-image: 
          radial-gradient(circle at 15% 20%, rgba(30, 58, 138, 0.5) 0%, transparent 45%),
          radial-gradient(circle at 85% 75%, rgba(161, 98, 7, 0.15) 0%, transparent 50%),
          radial-gradient(circle at 50% 50%, rgba(15, 23, 42, 0.8) 0%, transparent 100%);
        background-attachment: fixed;
        color: var(--text-cream);
        min-height: 100vh;
        margin: 0;
        padding: 60px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .container {
        max-width: 760px;
        width: 100%;
        background: var(--bg-card);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--border-gold);
        border-radius: 20px;
        padding: 48px;
        box-shadow: var(--glow);
        position: relative;
        overflow: hidden;
      }

      /* Subtle Botanical Background Ornament */
      .container::before {
        content: "🌿";
        position: absolute;
        top: -20px;
        right: -20px;
        font-size: 140px;
        opacity: 0.05;
        pointer-events: none;
      }

      header {
        text-align: center;
        margin-bottom: 40px;
        border-bottom: 1px solid var(--border-gold);
        padding-bottom: 30px;
      }

      h1 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 3.2rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #fef08a 0%, #eab308 50%, #fef3c7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0 0 8px 0;
      }

      .subtitle {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 1.25rem;
        color: var(--text-muted);
        margin: 0;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .card-link {
        text-decoration: none;
        color: inherit;
        display: block;
      }

      .card {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(234, 179, 8, 0.15);
        border-radius: 12px;
        padding: 20px 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .card:hover {
        background: rgba(30, 41, 59, 0.7);
        border-color: var(--border-gold-hover);
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(234, 179, 8, 0.15);
      }

      .card-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.45rem;
        font-weight: 600;
        color: var(--text-cream);
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .card-icon {
        color: var(--text-gold-accent);
        font-size: 1.1rem;
      }

      .arrow {
        color: var(--text-gold-accent);
        font-size: 1.2rem;
        opacity: 0.6;
        transition: transform 0.3s ease, opacity 0.3s ease;
      }

      .card:hover .arrow {
        opacity: 1;
        transform: translateX(4px);
      }

      /* Full width spanning for odd item balance */
      .grid li:last-child:nth-child(odd) {
        grid-column: 1 / -1;
      }

      footer {
        text-align: center;
        margin-top: 36px;
        font-size: 0.85rem;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>My Head Space</h1>
        <p class="subtitle">A digital garden of thought, prose, & digital craft</p>
      </header>
      
      <main>
        <ul class="grid">
          <li>
            <a href="/poetry" class="card-link">
              <div class="card">
                <span class="card-title"><span class="card-icon">✦</span> Poetry</span>
                <span class="arrow">→</span>
              </div>
            </a>
          </li>
          <li>
            <a href="/thoughts" class="card-link">
              <div class="card">
                <span class="card-title"><span class="card-icon">✦</span> My Thoughts</span>
                <span class="arrow">→</span>
              </div>
            </a>
          </li>
          <li>
            <a href="/notes" class="card-link">
              <div class="card">
                <span class="card-title"><span class="card-icon">✦</span> Gatherings Notes</span>
                <span class="arrow">→</span>
              </div>
            </a>
          </li>
          <li>
            <a href="/apps" class="card-link">
              <div class="card">
                <span class="card-title"><span class="card-icon">✦</span> Web Applications</span>
                <span class="arrow">→</span>
              </div>
            </a>
          </li>
          <li>
            <a href="/books" class="card-link">
              <div class="card">
                <span class="card-title"><span class="card-icon">✦</span> Books</span>
                <span class="arrow">→</span>
              </div>
            </a>
          </li>
        </ul>
      </main>

      <footer>
        Local-First Knowledge System
      </footer>
    </div>
  </body>
</html>