---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Web Applications - My Head Space</title>
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 680px;
        margin: 60px auto;
        padding: 0 20px;
        line-height: 1.6;
        background-color: #0f172a;
        color: #f8fafc;
      }
      a.back {
        color: #94a3b8;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 20px;
      }
      a.back:hover { color: #f8fafc; }
      h1 {
        font-size: 2rem;
        border-bottom: 2px solid #334155;
        padding-bottom: 12px;
      }
      .app-card {
        background: #1e293b;
        border: 1px solid #334155;
        padding: 20px;
        border-radius: 8px;
        margin-top: 20px;
      }
      .app-card h3 { margin-top: 0; color: #38bdf8; }
    </style>
  </head>
  <body>
    <a href="/" class="back">← Back to Home</a>
    <h1>Web Applications</h1>
    <p>A collection of lightweight interactive scripts and mini-tools.</p>

    <div class="app-card">
      <h3>Example Tool: Counter Widget</h3>
      <p>Click the button below to test local interactivity:</p>
      <button id="count-btn" style="padding: 8px 16px; background: #38bdf8; color: #0f172a; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">Count: 0</button>
    </div>

    <script>
      let count = 0;
      const btn = document.getElementById('count-btn');
      btn.addEventListener('click', () => {
        count++;
        btn.textContent = `Count: ${count}`;
      });
    </script>
  </body>
</html>
